{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A shopping list order",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pendente", "Aprovado", "Cancelado"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" }
            },
            "required": ["id", "name", "quantity"]
          }
        },
        "totalItems": { "type": "number" },
        "authorUID": { "type": "string" }
      },
      "required": ["createdAt", "status", "items", "totalItems", "authorUID"]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Orders created by users"
    }
  }
}
